PORT=5000

# Pooled connection (used by the app at runtime) — Neon's "-pooler" host
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct connection (used only for migrations) — Neon's non-pooled host
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# JWT Secret — Generate a secure random value in production (e.g. openssl rand -hex 32)
JWT_SECRET="your-secure-random-jwt-secret-here"
JWT_EXPIRES_IN="15m"
